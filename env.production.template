# F1 World Champion - Production Environment Template
# Copy this to .env.production and fill in your values

# Docker Configuration
DOCKER_USERNAME=your-dockerhub-username
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Database
MONGO_PASSWORD=your-secure-password-here
MONGO_DATABASE=f1-world-champion

# Application
NODE_ENV=production
APP_NAME=F1 World Champion
LOG_LEVEL=info
LOG_ENABLED=true

# Optional API Settings (uncomment if needed)
# F1_API_KEY=your-f1-api-key-here
# F1_API_BASE_URL=https://api.jolpi.ca/ergast/f1

# Optional Security Settings (uncomment if needed)
# JWT_SECRET=your-jwt-secret-here
# CORS_ORIGIN=https://yourdomain.com

# Usage:
# 1. Copy: cp env.production.template .env.production
# 2. Edit values above
# 3. Deploy: docker-compose --env-file .env.production -f docker-compose.prod.yml up -d 