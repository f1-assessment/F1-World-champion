# 🐳 F1 World Champion - Production Environment Template
# Copy this to .env.production and fill in your values

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Hub username (replace with your username)
DOCKER_USERNAME=your-dockerhub-username

# Image tags (use 'latest' for production, 'BE-dev' for testing)
BACKEND_TAG=latest
FRONTEND_TAG=latest

# =============================================================================
# PORT CONFIGURATION
# =============================================================================

# External ports (what users connect to)
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Internal ports (container ports - usually don't change these)
# Frontend internal: 3000
# Backend internal: 3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB root password (CHANGE THIS IN PRODUCTION!)
MONGO_PASSWORD=your-secure-password-here

# MongoDB database name
MONGO_DATABASE=f1-world-champion

# =============================================================================
# API CONFIGURATION
# =============================================================================

# External F1 API settings (if needed)
# F1_API_KEY=your-f1-api-key-here
# F1_API_BASE_URL=https://api.jolpi.ca/ergast/f1

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Node.js environment
NODE_ENV=production

# Application name
APP_NAME=F1 World Champion

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT Secret (if using authentication)
# JWT_SECRET=your-jwt-secret-here

# CORS settings (if needed)
# CORS_ORIGIN=https://yourdomain.com

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable/disable logging
LOG_ENABLED=true

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================

# Domain name (for nginx configuration)
# DOMAIN_NAME=yourdomain.com

# SSL certificate paths (for nginx with SSL)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

# Backup schedule (cron format)
# BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
# BACKUP_RETENTION=30

# =============================================================================
# EXAMPLE USAGE
# =============================================================================

# 1. Copy this file:
#    cp env.production.template .env.production
#
# 2. Edit the values:
#    nano .env.production
#
# 3. Deploy with docker-compose:
#    docker-compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# 4. Check status:
#    docker ps
#    docker logs f1-backend
#    docker logs f1-frontend 